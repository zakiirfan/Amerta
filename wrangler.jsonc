// Pengaturan Cloudflare Worker untuk aplikasi ini.
// Alamat aplikasi: https://amerta.azakfan.workers.dev
// (Sampai Oktober 2026 bernama "karyaanak" di karyaanak.azakfan.workers.dev.)
//
// ⚠️ Jangan ganti "name". Data di HP terikat pada alamat di atas;
// nama lain = alamat lain = data di HP tidak terbaca.
//
// Worker ini hanya menyajikan file statis dari folder app/ (tanpa kode server).
{
  "name": "amerta",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./app"
  },
  // Tanpa analytics atau log permintaan (aturan proyek: tidak ada analytics).
  "observability": {
    "enabled": false
  }
}
